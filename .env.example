# Copy to .env and fill in. Never commit .env.

# gemini (free tier, key: https://aistudio.google.com/apikey), anthropic (paid only),
# or ollama (free, runs on your own computer, no key: `ollama pull gemma3:4b`)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the model above is busy or out of free quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Protects the HTTP API. Use a long random string on any public host.
API_KEY=

# Nominatim's policy requires an identifying User-Agent.
NOMINATIM_USER_AGENT=snapcaption/0.1 (you@example.com)

DB_PATH=data/snapcaption.db
TEMP_UNIT=fahrenheit
MAX_UPLOAD_MB=15
