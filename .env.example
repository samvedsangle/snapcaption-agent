# Copy to .env and fill in. Never commit .env.

# gemini (free tier, key: https://aistudio.google.com/apikey) or anthropic (paid only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Protects the HTTP API. Use a long random string on any public host.
API_KEY=

# Nominatim's policy requires an identifying User-Agent.
NOMINATIM_USER_AGENT=snapcaption/0.1 (you@example.com)

DB_PATH=data/snapcaption.db
TEMP_UNIT=fahrenheit
MAX_UPLOAD_MB=15
